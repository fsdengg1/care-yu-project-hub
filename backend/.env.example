PORT=4100
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://care-yu-project-hub.onrender.com
DEMO_PASSWORD=Careyu@123
ROBOT_LEAD_EMAIL=robottech@careyu.ai
ROBOT_LEAD_PASSWORD=Careyu@9865
# Optional. fsdengg1@careyu.ai also accepts ROBOT_LEAD_PASSWORD.
FSDENGG1_PASSWORD=Careyu@9865
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_SSL=true

# Auth / email
FRONTEND_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=careyu.ai
SUPPORT_EMAIL=admin@careyu.ai
DEFAULT_REPORTING_MANAGER_EMAIL=robotlead1@careyu.ai
# Extra inboxes that also receive the invitation code (Elastic Email)
INVITATION_NOTIFY_EMAILS=fsdengg1@careyu.ai

# Elastic Email (required for real inbox delivery). Do not leave the API key empty.
EMAIL_PROVIDER=elasticemail
ELASTIC_EMAIL_API_KEY=
ELASTIC_EMAIL_FROM_EMAIL=aicareyuautomation@gmail.com
ELASTIC_EMAIL_SENDER_EMAIL=aicareyuautomation@gmail.com
ELASTIC_EMAIL_FROM_NAME=CareYu Automation
ELASTIC_EMAIL_SENDER_NAME=CareYu Automation
EMAIL_REPLY_TO=admin@careyu.ai
EMAIL_DEBUG=false

# Invitation / password reset
INVITATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_SETUP_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Development-only impersonation. Leave false.
ENABLE_DEV_ROLE_PREVIEW=false

# Responsibility reminders — backend scheduler, independent of the website
REMINDER_AFTER_HOURS=24
MAX_REMINDERS=3
ESCALATION_AFTER_REMINDERS=3
DAILY_DIGEST_ENABLED=true
NOTIFICATION_SCHEDULER_ENABLED=true
# Optional: pin the default Project Manager when multiple PMs exist
# DEFAULT_PROJECT_MANAGER_EMAIL=robotlead1@careyu.ai
